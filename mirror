#!/bin/sh
# iPhone screen mirror on this PC: AirPlay receiver named "Linux".
# NVDEC decodes on the GPU and glimagesink draws it with OpenGL.
# -srgb no: UxPlay's Linux default converts frames to packed 24-bit RGB, which
# NVIDIA's EGL can't import (black window) and waylandsink smears.
# max-display-delay=0: iOS only sends frames when the screen changes, and NVDEC's
# default display queue holds those frames back, leaving the window blank or frozen.
# -vsync no: with timestamp sync on, the sink judged nearly every frame late and
# dropped it (black window).
# -s asks for the iPhone 17 Pro's native portrait size at 60 fps.
exec uxplay -p -n Linux -vd "nvh264dec max-display-delay=0" -vs glimagesink -srgb no -vsync no -s 1206x2622@60 -fps 60 "$@"
